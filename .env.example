# Bedrock — one key for generation (Haiku 4.5), judge (Sonnet 4.6),
# and embeddings (Cohere Embed v4). See ADR 0001 and CLAUDE.md Models.
AWS_BEARER_TOKEN_BEDROCK=your-bedrock-api-key
AWS_REGION=ap-south-1

# Optional — if set, generation switches to gpt-4o-mini (ADR 0001)
# OPENAI_API_KEY=sk-...

# Postgres — compose refuses to start without a password
POSTGRES_USER=deepresearch
POSTGRES_PASSWORD=
# Local scripts read this DSN; use the same password as above
POSTGRES__DSN=postgresql://deepresearch:@localhost:5433/deepresearch

# Airflow web UI / REST API. An Airflow admin can execute code inside a task,
# which is where the Bedrock key lives — treat these as production credentials.
# Generate: openssl rand -base64 24
AIRFLOW_ADMIN_PASSWORD=
# Flask session signing key. Generate: openssl rand -hex 32
AIRFLOW_SECRET_KEY=
