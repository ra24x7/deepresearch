# Bedrock — one key for generation (Haiku 4.5), judge (Sonnet 4.6),
# and embeddings (Cohere Embed v4). See ADR 0001 and CLAUDE.md Models.
AWS_BEARER_TOKEN_BEDROCK=your-bedrock-api-key
AWS_REGION=ap-south-1

# Optional — if set, generation switches to gpt-4o-mini (ADR 0001)
# OPENAI_API_KEY=sk-...

# Postgres (compose provides defaults matching these)
POSTGRES_USER=deepresearch
POSTGRES_PASSWORD=deepresearch
